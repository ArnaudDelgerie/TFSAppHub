{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TFSAppHub",
  "identifier": "dev.tfsapp.hub",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "resources": ["resources/frankenphp", "resources/composer.phar"]
  }
}
